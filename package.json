{
  "name": "styleport-site",
  "version": "0.2.0",
  "private": true,
  "description": "The Eleventy-powered marketing site for StylePort, a privacy-first UserCSS manager for Safari.",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "eleventy --serve",
    "build": "eleventy",
    "test": "npm run build && node --test tests/*.test.mjs",
    "release:validate": "node tools/import-direct-release.mjs --validate-only",
    "release:import": "node tools/import-direct-release.mjs"
  },
  "devDependencies": {
    "@11ty/eleventy": "3.1.6",
    "parse5": "8.0.1"
  },
  "type": "module"
}
