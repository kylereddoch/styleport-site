<header class="site-header">
  <div class="shell nav-shell">
    <a class="brand brand-lockup" href="{{ '/' | url }}" aria-label="StylePort home">
      <img class="brand-lockup-light" src="{{ '/brand/styleport/logo/styleport-lockup-light.svg' | url }}" alt="" width="190" height="50">
      <img class="brand-lockup-dark" src="{{ '/brand/styleport/logo/styleport-lockup-dark.svg' | url }}" alt="" width="190" height="50">
    </a>
    <nav aria-label="Main navigation">
      <a href="{{ '/#features' | url }}">Features</a>
      <a href="{{ '/roadmap/' | url }}">Roadmap</a>
      <a href="{{ '/support/' | url }}">Support</a>
      <a href="{{ '/privacy/' | url }}">Privacy</a>
      <a href="{{ '/press/' | url }}">Press Kit</a>
    </nav>
    <div class="header-actions">
      <a class="nav-cta" href="{{ '/#download' | url }}">Get StylePort</a>
      <label class="appearance-control" hidden>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="12" r="8"/><path d="M12 4a8 8 0 0 1 0 16Z" fill="currentColor"/></svg>
        <span class="sr-only">Appearance</span>
        <select id="appearance" aria-label="Color theme"><option value="system">System</option><option value="light">Light</option><option value="dark">Dark</option></select>
      </label>
    </div>
  </div>
</header>
