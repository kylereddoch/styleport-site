<!doctype html>
<html lang="en" prefix="og: https://ogp.me/ns#">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ title | escape }}</title>
    <meta name="description" content="{{ (description or site.description) | escape }}">
    <meta name="robots" content="{% if noindex %}noindex, follow{% else %}index, follow, max-image-preview:large{% endif %}">
    <meta name="author" content="{{ site.developerName | escape }}">
    <meta name="color-scheme" content="light dark">
    <meta name="theme-color" content="#f5f7fb" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#111522" media="(prefers-color-scheme: dark)">
    {% if not noindex %}<link rel="canonical" href="{{ page.url | absoluteUrl(site.url) | escape }}">{% endif %}
    <link rel="icon" href="{{ '/brand/styleport/app/styleport-app-32.png' | url }}" type="image/png" sizes="32x32">
    <link rel="apple-touch-icon" href="{{ '/brand/styleport/app/styleport-app-180.png' | url }}" sizes="180x180">
    <link rel="sitemap" type="application/xml" href="{{ '/sitemap.xml' | absoluteUrl(site.url) }}">
    <meta property="og:site_name" content="{{ site.name | escape }}">
    <meta property="og:locale" content="en_US">
    <meta property="og:title" content="{{ title | escape }}">
    <meta property="og:description" content="{{ (description or site.description) | escape }}">
    <meta property="og:type" content="website">
    <meta property="og:url" content="{{ page.url | absoluteUrl(site.url) | escape }}">
    <meta property="og:image" content="{{ site.socialImage.path | absoluteUrl(site.url) | escape }}">
    <meta property="og:image:secure_url" content="{{ site.socialImage.path | absoluteUrl(site.url) | escape }}">
    <meta property="og:image:type" content="{{ site.socialImage.type }}">
    <meta property="og:image:width" content="{{ site.socialImage.width }}">
    <meta property="og:image:height" content="{{ site.socialImage.height }}">
    <meta property="og:image:alt" content="{{ site.socialImage.alt | escape }}">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ title | escape }}">
    <meta name="twitter:description" content="{{ (description or site.description) | escape }}">
    <meta name="twitter:image" content="{{ site.socialImage.path | absoluteUrl(site.url) | escape }}">
    <meta name="twitter:image:alt" content="{{ site.socialImage.alt | escape }}">
    {% if not noindex %}<script type="application/ld+json">{{ site | structuredData(title, description, page.url) | safe }}</script>{% endif %}
    <script src="{{ '/assets/theme.js' | url }}?v={{ site.assetVersion }}"></script>
    <link rel="stylesheet" href="{{ '/assets/site.css' | url }}?v={{ site.assetVersion }}">
  </head>
  <body>
    <div class="development-banner" role="status">
      <span>Development preview</span>
      <p>StylePort 1.0 is still being tested. <a href="{{ '/' | url }}#download">The public TestFlight beta is open</a>; direct downloads are not available yet.</p>
    </div>
    {% include "site-header.njk" %}
    <main id="main-content">
      {{ content | safe }}
    </main>
    {% include "site-footer.njk" %}
  </body>
</html>
