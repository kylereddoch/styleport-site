<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ title }}</title>
    <meta name="description" content="{{ description or site.description }}">
    <meta name="robots" content="index, follow">
    <meta name="color-scheme" content="light dark">
    <meta name="theme-color" content="#f7f3ed">
    <link rel="canonical" href="{{ site.url }}{{ page.url }}">
    <link rel="icon" href="{{ '/styleport-icon.png' | url }}" type="image/png">
    <link rel="apple-touch-icon" href="{{ '/styleport-icon.png' | url }}">
    <meta property="og:title" content="{{ title }}">
    <meta property="og:description" content="{{ description or site.description }}">
    <meta property="og:type" content="website">
    <meta property="og:url" content="{{ site.url }}{{ page.url }}">
    <meta property="og:image" content="{{ site.url }}/og.png">
    <meta property="og:image:width" content="1729">
    <meta property="og:image:height" content="910">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ title }}">
    <meta name="twitter:description" content="{{ description or site.description }}">
    <meta name="twitter:image" content="{{ site.url }}/og.png">
    <script src="{{ '/assets/theme.js' | url }}"></script>
    <link rel="stylesheet" href="{{ '/assets/site.css' | url }}">
  </head>
  <body>
    <div class="development-banner" role="status">
      <span>Development preview</span>
      <p>StylePort 1.0 is still being tested. Downloads are not available yet.</p>
    </div>
    {% include "site-header.njk" %}
    <main id="main-content">
      {{ content | safe }}
    </main>
    {% include "site-footer.njk" %}
  </body>
</html>
